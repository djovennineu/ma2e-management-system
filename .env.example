# Copiez ce fichier sous le nom .env et renseignez vos valeurs locales.
MA2E_DB_NAME=ma2e
MA2E_DB_USER=root
MA2E_DB_PASSWORD=
MA2E_DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
# Sans socket MAMP, retirez le socket et configurez l’hôte et le port.
MA2E_DB_HOST=127.0.0.1
MA2E_DB_PORT=8889

MA2E_SMTP_HOST=smtp.gmail.com
MA2E_SMTP_PORT=587
MA2E_SMTP_USERNAME=
MA2E_SMTP_PASSWORD=
MA2E_SMTP_FROM=
MA2E_SMTP_FROM_NAME="MA2E — Mutuelle"
